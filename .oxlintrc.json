{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "off",
    "pedantic": "off"
  },
  // Строки в проекте нормализованы в NFC (это гарантирует content/build.ts и тест
  // восстановления написания), поэтому [...слово] по кодовым точкам безопасно.
  "rules": {
    "typescript/no-misused-spread": "off",
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  },
  "ignorePatterns": ["dist", "public/content", "docs/art-sheet.html", ".vitest", "test-results", "playwright-report"]
}
